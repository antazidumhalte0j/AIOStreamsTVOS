diff --git a/packages/web/src/lib/hosts/shell/app-glass-panels.ts b/packages/web/src/lib/hosts/shell/app-glass-panels.ts
new file mode 100644
index 00000000..c2921086
--- /dev/null
+++ b/packages/web/src/lib/hosts/shell/app-glass-panels.ts
@@ -0,0 +1,212 @@
+import React from 'react';
+import { appBridge, appGlass } from './bridge';
+
+/*
+ * Glass panels drawn by the Apple TV app beneath the page (AIOStreamsTVOS, patches/web/0074).
+ *
+ * With Liquid glass and Glass panels on over the artwork background, the settings cards, the
+ * settings tab groups and the pill tabs sit over nothing of the page but the wash, which the app
+ * draws. Each draws no fill or blur of its own then (`data-app-glass` on the root), and the app
+ * puts tvOS's Liquid glass where it is. Menus, dialogs and the other panels open over page content,
+ * which glass beneath the page can't show through, so they keep the page's own glass.
+ *
+ * The page tells the app each panel's box, the part of it its scrolling ancestors leave in sight,
+ * and whether it's pinned (inside a sticky or fixed ancestor). The app moves the others with
+ * WebKit's scroll as it happens, and the page measures again when a scroll comes to rest, when
+ * anything resizes, appears or goes, and every frame while something animates.
+ */
+
+const PANELS =
+  "[data-ui='settings-card-body'],[data-ui='settings-tab-group'],[data-ui='pill-tabs']";
+
+/** Panels this far beyond the screen are given glass too, so a scroll finds them ready. */
+const MARGIN = 1;
+/** How long after an animation starts the panels are measured each frame. */
+const ANIMATING_MS = 800;
+/** A scroll with no event for this long has come to rest. */
+const SETTLED_MS = 120;
+
+interface Box {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+}
+
+const box = (r: DOMRect | Box): Box => ({
+  x: r.x,
+  y: r.y,
+  width: r.width,
+  height: r.height,
+});
+
+function intersect(a: Box, b: Box): Box {
+  const x = Math.max(a.x, b.x);
+  const y = Math.max(a.y, b.y);
+  const right = Math.min(a.x + a.width, b.x + b.width);
+  const bottom = Math.min(a.y + a.height, b.y + b.height);
+  return {
+    x,
+    y,
+    width: Math.max(0, right - x),
+    height: Math.max(0, bottom - y),
+  };
+}
+
+/** The part of `el` its clipping ancestors leave, and whether a sticky or fixed one holds it. */
+function placed(el: HTMLElement): { clip: Box; pinned: boolean } {
+  let clip = box(el.getBoundingClientRect());
+  let pinned = false;
+  for (
+    let up = el.parentElement;
+    up && up !== document.body;
+    up = up.parentElement
+  ) {
+    const style = getComputedStyle(up);
+    if (style.position === 'sticky' || style.position === 'fixed') pinned = true;
+    if (style.overflowX !== 'visible' || style.overflowY !== 'visible')
+      clip = intersect(clip, box(up.getBoundingClientRect()));
+  }
+  return { clip, pinned };
+}
+
+const shown = (el: HTMLElement) =>
+  typeof el.checkVisibility === 'function'
+    ? el.checkVisibility({ checkVisibilityCSS: true })
+    : el.getClientRects().length > 0;
+
+/** Whether the page shows its glass panels now: Liquid glass, over the artwork, no video. */
+function wanted(): boolean {
+  const root = document.documentElement;
+  return (
+    root.dataset.artGlass === 'liquid' &&
+    root.hasAttribute('data-art-wash') &&
+    !root.classList.contains('playing')
+  );
+}
+
+export function useAppGlassPanels(on: boolean) {
+  React.useEffect(() => {
+    const bridge = appBridge();
+    if (!on || !bridge || !appGlass()) return;
+    const root = document.documentElement;
+    let drawing = false;
+    // The app has panes of this page's now.
+    let sentAny = false;
+    let frame = 0;
+    let animatingUntil = 0;
+    let settle = 0;
+    const sizes = new ResizeObserver(() => soon());
+    const watched = new Set<Element>();
+
+    const send = () => {
+      frame = 0;
+      const now = wanted();
+      if (now !== drawing) {
+        drawing = now;
+        if (now) root.dataset.appGlass = '';
+        else delete root.dataset.appGlass;
+      }
+      if (!drawing) {
+        if (sentAny) bridge.send({ type: 'tvos-glass-panels', panels: [] });
+        sentAny = false;
+        return;
+      }
+      const height = window.innerHeight;
+      const reach: Box = {
+        x: -window.innerWidth,
+        y: -height * MARGIN,
+        width: window.innerWidth * 3,
+        height: height * (1 + 2 * MARGIN),
+      };
+      const panels: {
+        frame: Box;
+        clip: Box;
+        pinned: boolean;
+        radius: number;
+      }[] = [];
+      const found = new Set<Element>();
+      for (const el of document.querySelectorAll<HTMLElement>(PANELS)) {
+        found.add(el);
+        if (!watched.has(el)) {
+          watched.add(el);
+          sizes.observe(el);
+        }
+        if (!shown(el)) continue;
+        const frameBox = box(el.getBoundingClientRect());
+        if (!frameBox.width || !frameBox.height) continue;
+        const { clip, pinned } = placed(el);
+        if (!clip.width || !clip.height || !intersect(clip, reach).height)
+          continue;
+        panels.push({
+          frame: frameBox,
+          clip,
+          pinned,
+          radius: parseFloat(getComputedStyle(el).borderTopLeftRadius) || 0,
+        });
+      }
+      for (const el of watched)
+        if (!found.has(el)) {
+          watched.delete(el);
+          sizes.unobserve(el);
+        }
+      // Most pages have none: nothing to say again.
+      if (!panels.length && !sentAny) return;
+      sentAny = panels.length > 0;
+      bridge.send({
+        type: 'tvos-glass-panels',
+        panels,
+        scrollY: window.scrollY,
+        pageWidth: window.innerWidth,
+      });
+      if (performance.now() < animatingUntil) soon();
+    };
+    const soon = () => {
+      if (!frame) frame = requestAnimationFrame(send);
+    };
+    const animating = () => {
+      animatingUntil = performance.now() + ANIMATING_MS;
+      soon();
+    };
+    // The app moves the panels with the page's own scroll; a nested list's scroll it can't see.
+    const scrolled = (event: Event) => {
+      if (event.target !== document && event.target !== root) return soon();
+      clearTimeout(settle);
+      settle = window.setTimeout(soon, SETTLED_MS);
+    };
+
+    send();
+    const changes = new MutationObserver(soon);
+    changes.observe(document.body, {
+      subtree: true,
+      childList: true,
+      attributes: true,
+      attributeFilter: ['hidden', 'class', 'data-state'],
+    });
+    const looks = new MutationObserver(soon);
+    looks.observe(root, {
+      attributes: true,
+      attributeFilter: ['class', 'data-art-wash', 'data-art-glass'],
+    });
+    window.addEventListener('scroll', scrolled, {
+      capture: true,
+      passive: true,
+    });
+    window.addEventListener('resize', soon);
+    document.addEventListener('animationstart', animating, true);
+    document.addEventListener('transitionstart', animating, true);
+    return () => {
+      cancelAnimationFrame(frame);
+      clearTimeout(settle);
+      sizes.disconnect();
+      changes.disconnect();
+      looks.disconnect();
+      window.removeEventListener('scroll', scrolled, { capture: true });
+      window.removeEventListener('resize', soon);
+      document.removeEventListener('animationstart', animating, true);
+      document.removeEventListener('transitionstart', animating, true);
+      delete root.dataset.appGlass;
+      if (sentAny) bridge.send({ type: 'tvos-glass-panels', panels: [] });
+    };
+  }, [on]);
+}
