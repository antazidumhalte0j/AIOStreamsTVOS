 }
+/* The Apple TV app draws these panels' Liquid glass beneath the page (AIOStreamsTVOS). */
+html[data-art-wash][data-art-glass][data-app-glass]:not(.playing)
+  :is(
+    [data-ui='settings-card-body'],
+    [data-ui='settings-tab-group'],
+    [data-ui='pill-tabs']
+  ) {
+  border-color: transparent;
+  background: none;
+  box-shadow: none;
+  -webkit-backdrop-filter: none;
+  backdrop-filter: none;
+}
