+/**
+ * Whether focus came onto a `data-nav-down=start` box, as a page header's pickers, from a pick:
+ * back from a picker's list, which lies outside the page, or put back as the page drew again. Come
+ * from the page itself, it's a move, and Down goes to what lies below (AIOStreamsTVOS).
+ */
+const picked = new WeakMap<Element, boolean>();
+
+/** Notes where focus came onto `el` from, for `picked`. */
+export function arrived(el: Element, from: EventTarget | null): void {
+  const box = el.closest('[data-nav-down=start]');
+  if (!box) return;
+  // Along the pickers keeps what brought focus onto them.
+  if (from instanceof Element && box.contains(from)) return;
+  const page = box.closest('[data-page]');
+  picked.set(box, !(from instanceof Element && !!page?.contains(from)));
