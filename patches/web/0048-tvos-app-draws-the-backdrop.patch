index 000000000..65a26b50d
--- /dev/null
+++ b/packages/web/src/lib/hosts/shell/app-backdrop.ts
@@ -0,0 +1,242 @@
+import React from 'react';
+import { appBridge, appleTv } from './bridge';
+
+/*
+ * The Apple TV app draws the backdrop shown, the hero's or a title page's, at
+ * the screen's full 4K in a view beneath the page, rather than WebKit decoding
+ * it: the page's process is ended for memory long before the app runs short
+ * (AIOStreamsTVOS). The page keeps its own copy at 1920 under it, hidden, and
+ * shows that instead while it scrolls, as the app's view can't follow a scroll
+ * frame by frame; once the page has been still a moment, the app's takes over
+ * again, through a hole cut in the page's background (as for a trailer).
+ */
+
+/** How long the page holds still before the app's picture shows again: past a keyed scroll's glide. */
+const REST_MS = 450;
+/** As a page opens: past its entrance, which moves it a few pixels (the layout's `PAGE_FADE`). */
+const FIRST_MS = 800;
+/** On `<html>` while the app's picture shows, which hides the page's own copy (BridgeScript). */
+const SHOWN = 'data-app-backdrop';
+const MASK = ['mask-image', '-webkit-mask-image'];
+/** How much of the hole's height and width its bottom and start fade over, as the artwork background's masks do. */
+const FADE = 0.5;
+
+interface Rect {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+}
+
+const rectOf = (r: DOMRect): Rect => ({
+  x: r.left,
+  y: r.top,
+  width: r.width,
+  height: r.height,
+});
+
+function intersect(a: Rect, b: Rect): Rect | null {
+  const x = Math.max(a.x, b.x);
+  const y = Math.max(a.y, b.y);
+  const right = Math.min(a.x + a.width, b.x + b.width);
+  const bottom = Math.min(a.y + a.height, b.y + b.height);
+  return right - x >= 1 && bottom - y >= 1
+    ? { x, y, width: right - x, height: bottom - y }
+    : null;
+}
+
+/** In the page's pixels times its viewport scale, as `player-frame` is (VideoStage). */
+function scaled(r: Rect, scale: number): Rect {
+  return {
+    x: r.x * scale,
+    y: r.y * scale,
+    width: r.width * scale,
+    height: r.height * scale,
+  };
+}
+
+/** On the page's background while the hole cut in it is the backdrop's. */
+const HOLE = 'data-app-hole';
+
+/** The page's background cut away over `box`, its bottom and start fading back in when `soft`. */
+function cutHole(box: Rect, soft: boolean) {
+  const background = document.querySelector<HTMLElement>(
+    '[data-ui=page-background]'
+  );
+  const html = document.documentElement;
+  // A trailer's hole is cut there too; it plays only while the backdrop is hidden.
+  if (
+    !background ||
+    (html.hasAttribute('data-video-hole') && !background.hasAttribute(HOLE))
+  )
+    return false;
+  const view = background.getBoundingClientRect();
+  const x = box.x - view.left;
+  const y = box.y - view.top;
+  const { width: w, height: h } = box;
+  const rtl = html.dir === 'rtl';
+  /* eslint-disable lingui/no-unlocalized-strings -- SVG */
+  const edges = soft
+    ? `<defs><linearGradient id="d" x2="0" y2="1"><stop stop-opacity="0"/><stop offset="1"/></linearGradient>` +
+      `<linearGradient id="s" x1="${rtl ? 0 : 1}" x2="${rtl ? 1 : 0}"><stop stop-opacity="0"/><stop offset="1"/></linearGradient></defs>` +
+      `<rect x="${x - 1}" y="${y + h - h * FADE}" width="${w + 2}" height="${h * FADE + 1}" fill="url(#d)"/>` +
+      `<rect x="${rtl ? x + w - w * FADE : x - 1}" y="${y - 1}" width="${w * FADE + 1}" height="${h + 2}" fill="url(#s)"/>`
+    : '';
+  const svg =
+    `<svg xmlns="http://www.w3.org/2000/svg" width="${view.width}" height="${view.height}">` +
+    `<path fill-rule="evenodd" d="M0 0H${view.width}V${view.height}H0ZM${x} ${y}h${w}v${h}h${-w}Z"/>${edges}</svg>`;
+  /* eslint-enable lingui/no-unlocalized-strings */
+  const mask = `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
+  for (const name of MASK) background.style.setProperty(name, mask);
+  background.setAttribute(HOLE, '');
+  // The root is painted the page's colour too, but under a hole.
+  html.setAttribute('data-video-hole', '');
+  return true;
+}
+
+/** The hole closed, if it's this one's and not a trailer's since. */
+function closeHole() {
+  const background = document.querySelector<HTMLElement>(
+    '[data-ui=page-background]'
+  );
+  if (!background?.hasAttribute(HOLE)) return;
+  background.removeAttribute(HOLE);
+  for (const name of MASK) background.style.removeProperty(name);
+  document.documentElement.removeAttribute('data-video-hole');
+}
+
+let nextId = 0;
+
+/**
+ * On an Apple TV, has the app draw `src` where `art`'s `[data-ui=backdrop-frame]`
+ * lies, within `art`, while `on`. The page's own copy shows meanwhile, and while
+ * it scrolls. `quick` fades it in from nothing rather than over the last.
+ */
+export function useAppBackdrop(
+  art: React.RefObject<HTMLElement | null>,
+  src: string | undefined,
+  on: boolean
+) {
+  const shell = appBridge();
+  const active = !!shell && appleTv() && on && !!src;
+  // Changes of source while shown go to the app as they are, to fade there.
+  const latest = React.useRef(src);
+  latest.current = src;
+  const place = React.useRef<(() => void) | null>(null);
+  React.useEffect(() => {
+    if (!active || !shell) return;
+    const id = ++nextId;
+    const html = document.documentElement;
+    let shown: string | null = null;
+    let asked: string | null = null;
+    let clip: Rect | null = null;
+    let rest = 0;
+    let frame = 0;
+    const send = (message: Record<string, unknown>) =>
+      shell.send({ type: 'tvos-backdrop', id, ...message });
+    /** The page's copy back on screen first, then the hole closed beneath it and the app's put away. */
+    const hide = () => {
+      cancelAnimationFrame(frame);
+      if (asked === null && shown === null) return;
+      html.removeAttribute(SHOWN);
+      asked = null;
+      shown = null;
+      frame = requestAnimationFrame(() => {
+        closeHole();
+        send({ src: null });
+      });
+    };
+    const measure = () => {
+      const el = art.current;
+      const target = el?.querySelector<HTMLElement>(
+        '[data-slide="0"] [data-ui=backdrop-frame], :scope > [data-ui=backdrop-frame]'
+      );
+      if (!el || !target || !latest.current) return null;
+      const box = rectOf(target.getBoundingClientRect());
+      const within = intersect(rectOf(el.getBoundingClientRect()), box);
+      const visible =
+        within &&
+        intersect(within, {
+          x: 0,
+          y: 0,
+          width: innerWidth,
+          height: innerHeight,
+        });
+      return visible ? { box, visible } : null;
+    };
+    const show = () => {
+      const at = measure();
+      const next = latest.current;
+      if (!at || !next) return hide();
+      clip = at.visible;
+      asked = next;
+      const scale = window.visualViewport?.scale || 1;
+      send({
+        src: next,
+        frame: scaled(at.box, scale),
+        clip: scaled(at.visible, scale),
+        pageWidth: innerWidth * scale,
+        quick: shown === null,
+      });
+    };
+    place.current = () => {
+      // A new title while the app's shows or is on its way: it fades there; otherwise it waits for the page to rest.
+      if (asked !== null) show();
+    };
+    const unsubscribe = shell.subscribe((m) => {
+      const message = m as unknown as {
+        type: string;
+        id?: number;
+        src?: string | null;
+        drawn?: boolean;
+      };
+      if (message.type !== 'tvos-backdrop' || message.id !== id) return;
+      if (!message.drawn || message.src !== asked || !clip) return;
+      const first = shown === null;
+      shown = message.src;
+      if (!first) return;
+      // The app's is under the page's copy now: the hole first, then the copy hidden a frame later.
+      if (!cutHole(clip, html.hasAttribute('data-art-wash'))) return hide();
+      frame = requestAnimationFrame(() => {
+        if (shown !== null) html.setAttribute(SHOWN, '');
+      });
+    });
+    const moved = () => {
+      hide();
+      clearTimeout(rest);
+      rest = window.setTimeout(show, REST_MS);
+    };
+    const scrolled = (e: Event) => {
+      // A row scrolling sideways leaves the backdrop where it is.
+      const box = e.target === document ? document.scrollingElement : e.target;
+      if (box instanceof Node && art.current && !box.contains(art.current))
+        return;
+      moved();
+    };
+    const observer = new ResizeObserver(() => {
+      if (asked !== null || shown !== null) moved();
+    });
+    if (art.current) observer.observe(art.current);
+    document.addEventListener('scroll', scrolled, {
+      capture: true,
+      passive: true,
+    });
+    addEventListener('resize', moved);
+    rest = window.setTimeout(show, FIRST_MS);
+    return () => {
+      place.current = null;
+      clearTimeout(rest);
+      cancelAnimationFrame(frame);
+      observer.disconnect();
+      document.removeEventListener('scroll', scrolled, { capture: true });
+      removeEventListener('resize', moved);
+      unsubscribe();
+      html.removeAttribute(SHOWN);
+      closeHole();
+      send({ src: null });
+    };
+  }, [active, shell, art]);
+  React.useEffect(() => {
+    place.current?.();
+  }, [src]);
+}
