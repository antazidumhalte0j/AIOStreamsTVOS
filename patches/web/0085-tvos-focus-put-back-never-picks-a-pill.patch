+/**
+ * A tab that isn't picked gives way to its row's picked one: a tab picks as it's focused, and focus
+ * put back on a tab not picked would pick it, as it did when the page it was on had gone (AIOStreamsTVOS).
+ */
+function unpicked(el: HTMLElement | null): HTMLElement | null {
+  if (!el?.matches('[role=tab][aria-selected=false]')) return el;
+  return (
+    el
+      .closest('[role=tablist]')
+      ?.querySelector<HTMLElement>('[role=tab][aria-selected=true]') ?? el
+  );
+}
