+/**
+ * Cards fade in a little after one another, a page at a time. Not on an Apple TV: each card
+ * fading in was a layer of its own over the app's art, a row or a grid's page of them at once as
+ * items came in, which pressed WebKit's page process for memory (AIOStreamsTVOS).
+ */
 export function fadeIn(index: number) {
+  if (appleTv()) return {};
   return { ref: CARD_IN[index % 20] };
 }
 
