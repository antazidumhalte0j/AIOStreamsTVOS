+/* eslint-enable lingui/no-unlocalized-strings */
+
+export type TvTextKey = keyof (typeof TEXT)['en-GB'];
+
+type Table = Record<TvTextKey, string>;
+const tables = TEXT as unknown as Record<string, Table>;
+const languageOf = (tag: string) => tag.split('-')[0].toLowerCase();
+
+function tableFor(locale: string): Table {
+  if (tables[locale]) return tables[locale];
+  const language = languageOf(locale);
+  const same = Object.keys(tables).find((l) => languageOf(l) === language);
+  return same ? tables[same] : tables['en-GB'];
+}
+
+/** The Apple TV app's text for `key` in the active language, its `{name}`s filled from `values`. */
+export function tvText(
+  key: TvTextKey,
+  values?: Record<string, string | number>
+): string {
+  const text = tableFor(i18n.locale || 'en-GB')[key] ?? tables['en-GB'][key];
+  return values
+    ? text.replace(/\{(\w+)\}/g, (all, name: string) =>
+        name in values ? String(values[name]) : all
+      )
+    : text;
+}
