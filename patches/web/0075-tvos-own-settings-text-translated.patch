+  "ro": {
+    "about.tvosApp": "Aplicația tvOS",
+    "credit.ffmpeg": "Citește fiecare fișier și decodează ceea ce Apple TV nu are cu ce decoda.",
+    "credit.dav1d": "Decodează AV1, în interiorul FFmpeg.",
+    "credit.libdovi": "Citește și convertește metadatele Dolby Vision.",
+    "credit.libtruehd": "Decodează obiectele TrueHD Atmos pentru sunetul pe obiecte.",
