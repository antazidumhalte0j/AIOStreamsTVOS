+/** How long a page waits, once the page left is gone, before it's drawn. */
+const STAGE_AFTER_MS = 100;
+
+/**
+ * The open page's id once it may be drawn. On an Apple TV, a page opened or
+ * gone back to waits until the page it replaces has been taken down and a
+ * frame drawn without it, so WebKit can let go of that page before the next
+ * one's pictures and layers are made: both at once ended the page's process
+ * (AIOStreamsTVOS). A page pushed over the same one (`still`) shows at once.
+ */
+function useStagedOpen(open: Entry | undefined): number | undefined {
+  const staged = appleTv();
+  const id = open?.id;
+  const now = !staged || !!open?.still;
+  const [shown, setShown] = React.useState(id);
+  React.useEffect(() => {
+    if (now) return;
+    let timer = 0;
+    const frame = requestAnimationFrame(() => {
+      timer = window.setTimeout(() => setShown(id), STAGE_AFTER_MS);
+    });
+    return () => {
+      cancelAnimationFrame(frame);
+      clearTimeout(timer);
+    };
+  }, [id, now]);
+  return now || shown === id ? id : undefined;
+}
