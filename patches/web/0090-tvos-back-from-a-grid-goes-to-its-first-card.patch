+/**
+ * Back from a card in a grid past its first: that first card, before the navigation or leaving the
+ * page, which Back from there goes on to. Keys only: a tap leaves focus on a card, and Back from a
+ * touch screen leaves the page (AIOStreamsTVOS).
+ */
+export function gridBack(): boolean {
+  const from = keyboardFocus();
+  if (!from || scope() !== document.body) return false;
+  const grid = from.closest('[data-ui=card-grid]');
+  if (!grid || grid.closest('[inert]')) return false;
+  const first = [...grid.querySelectorAll<HTMLElement>(FOCUSABLE)].find(
+    (el) => !ruledOut(el) && canFocus(el)
+  );
+  if (!first || first === from || first.contains(from)) return false;
+  // A jump, not a step, so Down from there is found afresh.
+  lastMove = null;
+  focusOn(first);
+  return true;
+}
