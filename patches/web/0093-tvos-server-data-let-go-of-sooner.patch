+// A page shown, or kept behind the open one, still watches its catalog, which keeps all it loaded:
+// only one nothing watches is trimmed. Its next page is worked out from what it holds, so scrolling
+// it again carries on from the pages kept (AIOStreamsTVOS).
+if (appleTv())
+  queryClient.getQueryCache().subscribe((event) => {
+    if (event.type !== 'observerRemoved') return;
+    const { query } = event;
+    if (query.getObserversCount() || query.state.fetchStatus === 'fetching')
+      return;
+    const data = query.state.data as
+      | { pages?: unknown[]; pageParams?: unknown[] }
+      | undefined;
+    if (
+      !data ||
+      !Array.isArray(data.pages) ||
+      data.pages.length <= TV_KEPT_PAGES
+    )
+      return;
+    queryClient.setQueryData(
+      query.queryKey,
+      {
+        ...data,
+        pages: data.pages.slice(0, TV_KEPT_PAGES),
+        pageParams: data.pageParams?.slice(0, TV_KEPT_PAGES),
+      },
+      // Not newer than it was: what was stale still fetches again.
+      { updatedAt: query.state.dataUpdatedAt }
+    );
+  });
