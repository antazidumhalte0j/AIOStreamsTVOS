+/*
+ * On an Apple TV, what the server sent is let go of sooner: a query nothing shows goes after a
+ * minute rather than five, and a catalog nothing shows keeps only its first pages. Catalogs
+ * scrolled far held thousands of items between them, all in WebKit's page process, which tvOS ends
+ * for memory (AIOStreamsTVOS).
+ */
+const TV_GC_MS = 60_000;
+const TV_KEPT_PAGES = 2;
