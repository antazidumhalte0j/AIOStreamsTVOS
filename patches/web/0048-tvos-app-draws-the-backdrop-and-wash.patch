--- /dev/null
+++ b/packages/web/src/lib/hosts/shell/app-backdrop.ts
@@ -0,0 +1,348 @@
+import React from 'react';
+import { appBridge, appleTv } from './bridge';
+
+/*
+ * The Apple TV app draws the backdrop shown, the hero's or a title page's, at
+ * the screen's full 4K in a view beneath the page, rather than WebKit decoding
+ * it: the page's process is ended for memory long before the app runs short
+ * (AIOStreamsTVOS). The app draws it all the time, and follows the page's
+ * scroll itself, frame by frame (WebKit scrolls the page in the app's process).
+ * The page's own copy is hidden from the start, and shows only if the app
+ * can't draw the art: swapped with the app's each time the page moved, the two
+ * were both drawn for a moment, which flashed at the art's edges.
+ *
+ * The app draws the page's colour beneath it all too (`useAppPageColor`), and
+ * the wash with "Background from artwork" on, so the page's background is clear
+ * and the art shows through without a hole cut for it.
+ */
+
+/**
+ * As a page opens: past its entrance (the layout's `PAGE_FADE`, a spring that
+ * moves it 6 px and is still within a tenth of a pixel by 300 ms), which the
+ * app's art doesn't follow, so it's measured again then.
+ */
+const SETTLED_MS = 400;
+/** On `<html>` while the app draws the art, which hides the page's own copy (BridgeScript). */
+const SHOWN = 'data-app-backdrop';
+/** How much of the art's height and width its bottom and start fade over, as the artwork background's masks do. */
+const FADE = 0.5;
+/**
+ * The hero's corner backdrop fades into the page at its start and bottom
+ * whatever the background (its masks in hero.tsx): in by 45% of its width, and
+ * out over its last 55% (AIOStreamsTVOS).
+ */
+export const CORNER_FADE: HoleFade = { bottom: 0.55, start: 0.45 };
+
+interface Rect {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+}
+
+const rectOf = (r: DOMRect): Rect => ({
+  x: r.left,
+  y: r.top,
+  width: r.width,
+  height: r.height,
+});
+
+function intersect(a: Rect, b: Rect): Rect | null {
+  const x = Math.max(a.x, b.x);
+  const y = Math.max(a.y, b.y);
+  const right = Math.min(a.x + a.width, b.x + b.width);
+  const bottom = Math.min(a.y + a.height, b.y + b.height);
+  return right - x >= 1 && bottom - y >= 1
+    ? { x, y, width: right - x, height: bottom - y }
+    : null;
+}
+
+/** In the page's pixels times its viewport scale, as `player-frame` is (VideoStage). */
+function scaled(r: Rect, scale: number): Rect {
+  return {
+    x: r.x * scale,
+    y: r.y * scale,
+    width: r.width * scale,
+    height: r.height * scale,
+  };
+}
+
+/** How much of the art's height its bottom, and of its width its start, fade out over. */
+export interface HoleFade {
+  bottom: number;
+  start: number;
+}
+
+/** Backdrops the app draws now, which hide the page's copies while any is. */
+let drawing = 0;
+let nextId = 0;
+
+/** Where in `art` the picture lies: the hero's shown slide's frame, or a title page's. */
+const FRAME =
+  '[data-slide="0"] [data-ui=backdrop-frame], :scope > [data-ui=backdrop-frame]';
+
+/**
+ * How far in from its start the backdrop frame fades in (hero.tsx's
+ * `BackdropFrame`, a 12rem mask in landscape or from 1024 px wide), in the
+ * page's pixels; none for another frame. With the artwork background on, the
+ * app's art fades so too, as the page's copy does; off, the page draws that
+ * edge over the art in its own colour (BridgeScript).
+ */
+const frameFadeOf = (target: HTMLElement) =>
+  target.matches('[data-ui=backdrop-frame]') &&
+  matchMedia('(orientation: landscape), (min-width: 1024px)').matches
+    ? 12 *
+      (parseFloat(getComputedStyle(document.documentElement).fontSize) || 16)
+    : 0;
+
+/**
+ * On an Apple TV, has the app draw `src` where `art`'s `frame` lies, within
+ * `art`, while `on`. Its edges fade out over `fade`, or with the artwork
+ * background on over half its height and width, as that background's masks do.
+ */
+export function useAppBackdrop(
+  art: React.RefObject<HTMLElement | null>,
+  src: string | undefined,
+  on: boolean,
+  {
+    frame: frameSelector = FRAME,
+    fade,
+    hidden = false,
+  }: {
+    frame?: string;
+    fade?: HoleFade;
+    /**
+     * A trailer plays in the art's place: the app fades its art off it and
+     * back after.
+     */
+    hidden?: boolean;
+  } = {}
+) {
+  const options = React.useRef({ frameSelector, fade, hidden });
+  options.current = { frameSelector, fade, hidden };
+  const shell = appBridge();
+  const active = !!shell && appleTv() && on && !!src;
+  // The art the app couldn't load, which the page draws itself instead.
+  const [failedSrc, setFailedSrc] = React.useState<string>();
+  const failedRef = React.useRef(failedSrc);
+  failedRef.current = failedSrc;
+  // Changes of source go to the app as they are, to crossfade there.
+  const latest = React.useRef(src);
+  latest.current = src;
+  const tell = React.useRef<(() => void) | null>(null);
+  React.useEffect(() => {
+    if (!active || !shell) return;
+    const id = ++nextId;
+    const html = document.documentElement;
+    let asked: string | null = null;
+    let drawn = false;
+    /** Counted among the backdrops the app draws, which hides the page's copies. */
+    let holding = false;
+    let frame = 0;
+    const hold = (on: boolean) => {
+      if (on === holding) return;
+      holding = on;
+      if (on && drawing++ === 0) html.setAttribute(SHOWN, '');
+      if (!on && --drawing === 0) html.removeAttribute(SHOWN);
+    };
+    const send = (message: Record<string, unknown>) =>
+      shell.send({ type: 'tvos-backdrop', id, ...message });
+    /** How the art fades into what's beneath: as asked, or as the artwork background's masks do. */
+    const edgesNow = (): HoleFade | null =>
+      options.current.fade ??
+      (html.hasAttribute('data-art-wash')
+        ? { bottom: FADE, start: FADE }
+        : null);
+    const measure = () => {
+      const el = art.current;
+      const target = el?.querySelector<HTMLElement>(
+        options.current.frameSelector
+      );
+      if (!el || !target) return null;
+      // Where the page will be once its entrance ends (the layout's `PAGE_FADE`, which slides it up
+      // from 6 px below by its `top`): placed where it was then, the art sat that low, a gap above
+      // it, until it was measured again as the entrance settled (AIOStreamsTVOS).
+      const page = el.closest<HTMLElement>('[data-page]');
+      const rising = page ? parseFloat(getComputedStyle(page).top) || 0 : 0;
+      const settledRect = (r: DOMRect): Rect => ({
+        ...rectOf(r),
+        y: r.top - rising,
+      });
+      const box = settledRect(target.getBoundingClientRect());
+      // The whole of the art's box, off screen too: the app follows the page's scroll itself, and
+      // the page's masks measure their fades from it.
+      const within = intersect(settledRect(el.getBoundingClientRect()), box);
+      return within ? { box, within, target } : null;
+    };
+    const show = () => {
+      cancelAnimationFrame(frame);
+      const at = measure();
+      const next = latest.current;
+      if (!at || !next) return;
+      // The page draws that one itself; a title page's next source goes to the app again.
+      if (next === failedRef.current) return hold(false);
+      hold(true);
+      if (next !== asked) drawn = false;
+      asked = next;
+      const scale = window.visualViewport?.scale || 1;
+      const fade = edgesNow();
+      send({
+        src: next,
+        frame: scaled(at.box, scale),
+        clip: scaled(at.within, scale),
+        pageWidth: innerWidth * scale,
+        // Where the page was scrolled to as it measured, which the app follows the scroll from.
+        scrollY: (document.scrollingElement?.scrollTop ?? 0) * scale,
+        quick: !drawn,
+        // No copy of the page's shows over it: the app fades it in from nothing itself.
+        noCopy: true,
+        ...(fade && {
+          fade,
+          rtl: html.dir === 'rtl',
+          frameFade: html.hasAttribute('data-art-wash')
+            ? frameFadeOf(at.target) * scale
+            : 0,
+        }),
+        ...(options.current.hidden && { hidden: true }),
+      });
+    };
+    /** Measured again on the next frame, once whatever moved it has. */
+    const later = () => {
+      cancelAnimationFrame(frame);
+      frame = requestAnimationFrame(show);
+    };
+    tell.current = () => {
+      if (asked !== null || !drawn) show();
+    };
+    const unsubscribe = shell.subscribe((m) => {
+      const message = m as unknown as {
+        type: string;
+        id?: number;
+        src?: string | null;
+        drawn?: boolean;
+        failed?: boolean;
+      };
+      if (message.type !== 'tvos-backdrop' || message.id !== id) return;
+      if (message.failed && message.src && message.src === asked) {
+        // The app couldn't load it: the page loads and draws its own copy instead.
+        hold(false);
+        setFailedSrc(message.src);
+        return;
+      }
+      if (message.drawn && message.src === asked) drawn = true;
+    });
+    // A box scrolled inside the page carries the art where the app can't follow: told each frame.
+    const scrolled = (e: Event) => {
+      if (e.target === document) return;
+      const box = e.target;
+      if (box instanceof Node && art.current && box.contains(art.current))
+        later();
+    };
+    const observer = new ResizeObserver(later);
+    if (art.current) observer.observe(art.current);
+    // The artwork background coming or going changes how the art's edges fade.
+    const washes = new MutationObserver((records) => {
+      if (
+        records.some(
+          (r) =>
+            (r.oldValue !== null) !== html.hasAttribute(r.attributeName ?? '')
+        )
+      )
+        show();
+    });
+    washes.observe(html, {
+      attributeFilter: ['data-art-wash'],
+      attributeOldValue: true,
+    });
+    document.addEventListener('scroll', scrolled, {
+      capture: true,
+      passive: true,
+    });
+    addEventListener('resize', later);
+    show();
+    const settled = window.setTimeout(show, SETTLED_MS);
+    return () => {
+      tell.current = null;
+      clearTimeout(settled);
+      cancelAnimationFrame(frame);
+      observer.disconnect();
+      washes.disconnect();
+      document.removeEventListener('scroll', scrolled, { capture: true });
+      removeEventListener('resize', later);
+      unsubscribe();
+      hold(false);
+      // Faded out by the app, over the next page's art coming in.
+      send({ src: null, fade: true });
+    };
+  }, [active, shell, art]);
+  React.useEffect(() => {
+    tell.current?.();
+  }, [src, hidden]);
+  // Off an Apple TV, or for art the app couldn't load, the page draws its own; otherwise it loads
+  // none, as the app draws it (AIOStreamsTVOS).
+  return { copy: !shell || !appleTv() || (!!src && src === failedSrc) };
+}
+
+/** On `<html>` once the app draws the page's colour beneath it (BridgeScript clears the page's own). */
+const COLOR = 'data-app-color';
+
+/**
+ * On an Apple TV, the page's colour drawn by the app beneath everything, so
+ * the page's background is clear and the art the app draws shows through it
+ * without a hole (AIOStreamsTVOS). Read off a probe, as a theme or the user's
+ * CSS may change it, and told again when it does.
+ */
+export function useAppPageColor() {
+  React.useEffect(() => {
+    const shell = appBridge();
+    if (!shell || !appleTv()) return;
+    const html = document.documentElement;
+    const probe = document.createElement('div');
+    probe.dataset.ui = 'page-color-probe';
+    probe.style.cssText =
+      // eslint-disable-next-line lingui/no-unlocalized-strings -- CSS
+      'position: fixed; width: 0; height: 0; pointer-events: none; background-color: var(--background)';
+    document.body.append(probe);
+    let sent = '';
+    let seen = '';
+    // Through a pixel of a canvas, so the app gets plain red, green and blue whatever form the
+    // theme gives the colour in (`oklch()`, `color-mix()`).
+    const canvas = document.createElement('canvas');
+    canvas.width = 1;
+    canvas.height = 1;
+    const pixel = canvas.getContext('2d', { willReadFrequently: true });
+    const check = () => {
+      const css = getComputedStyle(probe).backgroundColor;
+      if (!css || css === seen || !pixel) return;
+      seen = css;
+      pixel.clearRect(0, 0, 1, 1);
+      pixel.fillStyle = css;
+      pixel.fillRect(0, 0, 1, 1);
+      const [r, g, b] = pixel.getImageData(0, 0, 1, 1).data;
+      const color = `rgb(${r}, ${g}, ${b})`;
+      if (color === sent) return;
+      sent = color;
+      shell.send({ type: 'tvos-page-color', color });
+    };
+    const unsubscribe = shell.subscribe((m) => {
+      const message = m as unknown as {
+        type: string;
+        color?: string;
+        drawn?: boolean;
+      };
+      if (message.type !== 'tvos-page-color') return;
+      if (message.drawn && message.color === sent) html.setAttribute(COLOR, '');
+      else if (message.drawn === false) html.removeAttribute(COLOR);
+    });
+    check();
+    // A theme's colours come in a style element the page changes: cheap to read, so read often.
+    const timer = window.setInterval(check, 1000);
+    return () => {
+      clearInterval(timer);
+      unsubscribe();
+      probe.remove();
+      html.removeAttribute(COLOR);
+      shell.send({ type: 'tvos-page-color', color: null });
+    };
+  }, []);
+}
