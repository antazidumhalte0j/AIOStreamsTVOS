+/*
+ * On an Apple TV, a CSS animation, which WebKit drops with its element. One by `animate`, ended,
+ * stayed alive with its card after the card was taken down, cancelled or not: over two thousand
+ * in one session (AIOStreamsTVOS). Its keyframes are added once, as the first card comes in.
+ */
+const TV_CARD_IN = 'aio-card-in';
+const TV_CARD_FADE = 'aio-card-fade';
+let tvKeyframes = false;
+function tvCardIn(el: HTMLElement, delay: number) {
+  if (!tvKeyframes) {
+    tvKeyframes = true;
+    const style = document.createElement('style');
+    style.textContent =
+      // eslint-disable-next-line lingui/no-unlocalized-strings -- CSS
+      `@keyframes ${TV_CARD_IN}{from{opacity:0;transform:translateY(8px)}}@keyframes ${TV_CARD_FADE}{from{opacity:0}}`;
+    document.head.append(style);
+  }
+  // eslint-disable-next-line lingui/no-unlocalized-strings -- CSS
+  el.style.animation = `${reducedMotion?.matches ? TV_CARD_FADE : TV_CARD_IN} 300ms ease-out ${delay}ms backwards`;
+}
