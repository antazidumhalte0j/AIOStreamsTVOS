+/** The Apple TV app's upscaling of live channels (`settings.video.upscalingLive`, AIOStreamsTVOS). */
+function LiveUpscalingSwitch() {
+  const [live, setLive] = useSetting(settings.video.upscalingLive);
+  return (
+    <Switch
+      side="right"
+      label={tvText('upscaling.liveLabel')}
+      help={tvText('upscaling.liveHelp')}
+      value={live}
+      onValueChange={setLive}
+    />
+  );
+}
