+/**
+ * Where focus last was on a TV, measured on the page, so a move with focus lost carries on from
+ * there (AIOStreamsTVOS).
+ */
+let lastPlace: {
+  el: HTMLElement;
+  page: Element | null;
+  x: number;
+  y: number;
+} | null = null;
+
+/** Notes where `el`, just focused, lies on the page. */
+export function notePlace(el: Element): void {
+  if (
+    !(el instanceof HTMLElement) ||
+    !document.documentElement.hasAttribute('data-tv')
+  )
+    return;
+  const r = el.getBoundingClientRect();
+  lastPlace = {
+    el,
+    page: el.closest('[data-page]'),
+    x: r.left,
+    y: r.top + window.scrollY,
+  };
+}
+
+/**
+ * With focus lost, as a row whose title had it found it had nothing to show and went, what lies
+ * nearest where it was, that way first. Upstream's start of the page from nothing focused found
+ * nothing on a screen of rows still loading, whose titles it passes over, and fell to the first
+ * thing on the screen, the navigation, which opened (AIOStreamsTVOS).
+ */
+function nearLost(dir: Direction): HTMLElement | null {
+  const lost = lastPlace;
+  if (!lost || lost.el.isConnected) return null;
+  const page = lost.page;
+  if (!page?.isConnected || page.closest('[inert]')) return null;
+  // Rows after one that went move up into its place, so a little above still counts as below.
+  const slack = 8;
+  const y = lost.y - window.scrollY;
+  let best: HTMLElement | null = null;
+  let score = Infinity;
+  for (const el of page.querySelectorAll<HTMLElement>(FOCUSABLE)) {
+    if (ruledOut(el) || el.closest('[data-nav-out]')) continue;
+    const r = el.getBoundingClientRect();
+    if (!canFocus(el, r)) continue;
+    const dy = r.top - y;
+    const wrongWay =
+      (dir === 'down' && dy < -slack) || (dir === 'up' && dy > slack);
+    const s =
+      (wrongWay ? 1e7 : 0) + Math.abs(dy) * 4 + Math.abs(r.left - lost.x);
+    if (s < score) {
+      best = el;
+      score = s;
+    }
+  }
+  return best;
+}
