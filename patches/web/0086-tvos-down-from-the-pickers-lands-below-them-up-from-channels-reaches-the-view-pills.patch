+/**
+ * Where Down from `from` reaches the row `start` is in: the item of that row straight below it, or
+ * the nearest along, as the row's first only when nothing else lies in that row (AIOStreamsTVOS).
+ */
+function beneath(from: HTMLElement, start: HTMLElement): HTMLElement {
+  const mark = start.closest<HTMLElement>('[data-nav-start]');
+  if (!mark) return start;
+  const row = rectOf(start);
+  const at = rectOf(from);
+  const edge = mark.getBoundingClientRect();
+  let best = start;
+  let apart = Infinity;
+  for (const el of mark.querySelectorAll<HTMLElement>(FOCUSABLE)) {
+    if (ruledOut(el) || el.closest('[data-nav-out]') || inTitle(el)) continue;
+    const r = rectOf(el);
+    if (r.bottom <= row.top || r.top >= row.bottom || !canFocus(el, r))
+      continue;
+    // Not one scrolled out of its row or off the screen.
+    if (
+      r.right <= Math.max(edge.left, 0) ||
+      r.left >= Math.min(edge.right, innerWidth)
+    )
+      continue;
+    // Beside it by how far its edges lie apart, the nearer centre first among those it overlaps.
+    const gap =
+      Math.max(r.left - at.right, at.left - r.right, 0) +
+      Math.abs(r.left + r.width / 2 - (at.left + at.width / 2)) / 1000;
+    if (gap < apart) {
+      best = el;
+      apart = gap;
+    }
+  }
+  return best;
+}
