+/**
+ * The app's video as a docked player goes. Still small, the next one places
+ * it, so it never fills the screen between them; closed, the app has the stop
+ * first, which hides it, and then the whole screen back for the next title.
+ * A frame of none at once filled the screen with a TV's live channel for the
+ * wait between pages, until it stopped (AIOStreamsTVOS).
+ */
+function letGo(setFrame: PlayerController['setFrame']) {
+  if (!setFrame) return;
+  const open = playbackNow();
+  if (open?.mini) return;
+  if (open) setFrame(null);
+  else setTimeout(() => setFrame(null));
+}
+
+/** A TV between one page's preview and the next: the video waits unseen. */
+function BetweenDocks({ player }: MiniPlayerProps) {
+  const setFrame = player?.setFrame;
+  const latestSetFrame = React.useRef(setFrame);
+  latestSetFrame.current = setFrame;
+  const framed = !!setFrame;
+  React.useEffect(() => {
+    if (framed) latestSetFrame.current?.(NOWHERE);
+  }, [framed]);
+  React.useEffect(() => () => letGo(latestSetFrame.current), []);
+  return null;
 }
 
